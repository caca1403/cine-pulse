{
  "format": "cinepulse-flow/1",
  "id": "fhdf",
  "name": "FullHDFilmizlesene",
  "mediaTypes": ["movie"],
  "baseUrl": "https://www.fullhdfilmizlesene.now",
  "steps": [
    { "op": "request", "url": "{{base}}/arama/{{title:url}}", "save": "search" },
    { "op": "links", "from": "search", "save": "matches", "pathIncludes": "/film/" },
    { "op": "select", "from": "matches", "save": "item" },
    { "op": "extract", "url": "{{item.url}}", "referer": "{{base}}/", "save": "media" },
    { "op": "emit", "from": "media" }
  ]
}
