{
  "version": 2,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/fex/(.*)",
      "destination": "https://filmekseni.vip/$1"
    },
    {
      "source": "/api/hdi/(.*)",
      "destination": "https://www.hdfilmizle.vip/$1"
    },
    {
      "source": "/api/dzy/(.*)",
      "destination": "https://www.diziyou.one/$1"
    },
    {
      "source": "/api/dbl/(.*)",
      "destination": "https://dizibal.com/api/$1"
    },
    {
      "source": "/api/dzp/(.*)",
      "destination": "https://dizipal.bid/$1"
    },
    {
      "source": "/api/flz/(.*)",
      "destination": "https://filmizlech.com/$1"
    },
    {
      "source": "/api/hfd/(.*)",
      "destination": "https://hdfilmdelisi.one/$1"
    },
    {
      "source": "/api/hdfc/(.*)",
      "destination": "https://www.hdfilmcehennemi.now/$1"
    },
    {
      "source": "/api/fin/(.*)",
      "destination": "https://filmizle.now/$1"
    },
    {
      "source": "/api/vidmixi/(.*)",
      "destination": "https://vidmixi.com/$1"
    },
    {
      "source": "/api/fmk/(.*)",
      "destination": "https://filmmakinesi.to/$1"
    },
    {
      "source": "/api/snx",
      "destination": "/api/snx"
    },
    {
      "source": "/api/snx/(.*)",
      "destination": "/api/snx?path=$1"
    },
    {
      "source": "/api/jet",
      "destination": "/api/jet"
    },
    {
      "source": "/api/jet/(.*)",
      "destination": "/api/jet?path=$1"
    },
    {
      "source": "/api/ddz",
      "destination": "/api/ddz"
    },
    {
      "source": "/api/ddz/(.*)",
      "destination": "/api/ddz?path=$1"
    },
    {
      "source": "/api/dzs",
      "destination": "/api/dzs"
    },
    {
      "source": "/api/dzs/(.*)",
      "destination": "/api/dzs?path=$1"
    },
    {
      "source": "/api/ybd",
      "destination": "/api/ybd"
    },
    {
      "source": "/api/ybd/(.*)",
      "destination": "/api/ybd?path=$1"
    },
    {
      "source": "/api/dzb",
      "destination": "/api/dzb"
    },
    {
      "source": "/api/dzb/(.*)",
      "destination": "/api/dzb?path=$1"
    },
    {
      "source": "/api/dzyo",
      "destination": "/api/dzyo"
    },
    {
      "source": "/api/dzyo/(.*)",
      "destination": "/api/dzyo?path=$1"
    },
    {
      "source": "/api/dzr",
      "destination": "/api/dzr"
    },
    {
      "source": "/api/dzr/(.*)",
      "destination": "/api/dzr?path=$1"
    },
