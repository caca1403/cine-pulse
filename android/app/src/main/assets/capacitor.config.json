{
	"appId": "com.cinepulse.studio",
	"appName": "CinePulse",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"android": {
		"allowMixedContent": true,
		"captureInput": true,
		"webContentsDebuggingEnabled": false
	},
	"plugins": {
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#0d0f17"
		}
	}
}
