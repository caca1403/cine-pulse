# CinePulse Studio — SIR ADLARI SÖZLÜĞÜ (DEĞERLER DEĞİL!)
# Gerçek değerleri yerel `.env` dosyasına yaz; `.env` depoya GİRMEZ (gitignore).
# Kopyala: cp .env.example .env

# Anizium (Aria) oturumu — kod artık OKUMUYOR (worker tarafında); yalnız geçmiş referans
# VITE_ANIZIUM_TOKEN_KEY=
# VITE_ANIZIUM_CLIENT_KEY=
# VITE_ANIZIUM_SESSION=
# VITE_ANIZIUM_PROFILE=
# VITE_ANIZIUM_USER_ID=

# Kendi Cloudflare Worker vekilimiz (üçüncü taraf değil)
VITE_ANIZIUM_WORKER=

# Trakt OAuth köprüsü (api/_traktToken.js) — SUNUCU tarafı, bundle'a GİRMEZ
TRAKT_CLIENT_SECRET=

# Xtream panel kimlikleri (api/_xtream_panels.js) — SUNUCU tarafı, bundle'a GİRMEZ
# Örnek: {"host":"panel.example:2095","panels":[{"id":"p1","label":"Panel 1","user":"u","pass":"p"}]}
XTREAM_PANELS=

# Aria (Nightwing) Cf-Control anahtarı (api/_ariaKey.js) — SUNUCU tarafı, bundle'a GİRMEZ
ARIA_CF_KEY=

# Kullanımdaki opsiyonel kökler
VITE_MKV_RELAY_ORIGIN=
VITE_XTREAM_RELAY_ORIGIN=

# PLANLANAN: sabit kodlu TMDB/Trakt anahtarları da buraya taşınacak (bkz. docs/GUVENLIK.md)
VITE_TMDB_KEY=
VITE_TMDB_KEY_2=
VITE_TMDB_KEY_3=

# #15 paylaşım/QR için herkese web adresi (native kabukta localhost yerine bu kullanılır)
# VITE_SITE_ADRESI=https://ornek.vercel.app
