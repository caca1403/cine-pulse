# CinePulse Studio — SIR ADLARI SÖZLÜĞÜ (DEĞERLER DEĞİL!)
# Gerçek değerleri yerel `.env` dosyasına yaz; `.env` depoya GİRMEZ (gitignore).
# Kopyala: cp .env.example .env

# Anizium (Aria) oturumu — canlı hesap çerezi, sızarsa yenisiyle değiştir
VITE_ANIZIUM_TOKEN_KEY=
VITE_ANIZIUM_CLIENT_KEY=
VITE_ANIZIUM_SESSION=
VITE_ANIZIUM_PROFILE=
VITE_ANIZIUM_USER_ID=

# Kendi Cloudflare Worker vekilimiz (üçüncü taraf değil)
VITE_ANIZIUM_WORKER=

# Kullanımdaki opsiyonel kökler
VITE_MKV_RELAY_ORIGIN=
VITE_XTREAM_RELAY_ORIGIN=

# PLANLANAN: sabit kodlu TMDB/Trakt anahtarları da buraya taşınacak (bkz. docs/GUVENLIK.md)
VITE_TMDB_KEY=
VITE_TMDB_KEY_2=
VITE_TMDB_KEY_3=
